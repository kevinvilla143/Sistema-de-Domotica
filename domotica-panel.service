[Unit]
Description=Panel Domotica (Flask + gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=domotica
Group=domotica
WorkingDirectory=/opt/domotica/app
EnvironmentFile=/etc/domotica/panel.env
# UN solo worker: las sesiones viven en memoria
ExecStart=/opt/domotica/venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:8000 --timeout 30 server:app
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
